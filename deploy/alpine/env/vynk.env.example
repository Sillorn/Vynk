# Copy to /etc/vynk/vynk.env; chmod 0600 and keep secrets out of source control.
# Spring profile and DB file location are supplied through environment overrides.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL='jdbc:h2:file:/var/lib/vynk/vynk;DB_CLOSE_ON_EXIT=FALSE'
SPRING_DATASOURCE_USERNAME=vynk
SPRING_DATASOURCE_PASSWORD=replace-with-a-long-random-secret
VYNK_API_DOCS_ENABLED=false
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
